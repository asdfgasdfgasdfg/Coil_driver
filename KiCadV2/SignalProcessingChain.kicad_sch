		(uuid "109553a5-291e-49c1-87d8-ab8313459197")
	)
	(text "Coil1 & Coil2 PWM is 180 phase offset. This way, Coil1 is \ngenerally on when Coil2 is off and vice versa.\nSo overall current ripple, reverse current, etc is minimised.\n\nCoil2 Needs low DAC value for high PWM, vice versa for Coil1.\n\n"
		(exclude_from_sim no)
		(at 62.23 136.144 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1844ece4-ae2e-4d73-a7f0-e1a6bb77d987")
	)
